{
  "name": "pi-coding-agent-extensions",
  "version": "0.0.0",
  "private": false,
  "packageManager": "pnpm@11.18.0",
  "description": "Monorepo for pi.dev extensions, themes, and packages",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixu1980/pi-coding-agent-extensions.git"
  },
  "homepage": "https://github.com/pixu1980/pi-coding-agent-extensions#readme",
  "bugs": {
    "url": "https://github.com/pixu1980/pi-coding-agent-extensions/issues"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "format": "prettier --write 'packages/*/src/**/*.ts'",
    "lint": "echo 'No linter configured yet'",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "test:all": "node scripts/test-all.mjs",
    "test:coverage": "node scripts/test-all.mjs --coverage"
  },
  "devDependencies": {
    "commit-and-tag-version": "^13.1.2"
  }
}
