{
  "name": "@pixu1980/pi-mcp",
  "version": "0.1.10",
  "private": false,
  "description": "[dual-use] MCP (Model Context Protocol) adapter for Pi coding agent - fork of pi-mcp-adapter with configurable tool advisory threshold",
  "type": "module",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./types": {
      "types": "./types.ts",
      "import": "./types.ts",
      "default": "./types.ts"
    }
  },
  "license": "MIT",
  "author": "Emiliano 'pixu1980' Pisu",
  "contributors": [
    "Nico Bailon (original pi-mcp-adapter)"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pi-mcp": "lib/_cli.js"
  },
  "scripts": {
    "test": "node --import tsx --test __tests__/index.test.mjs",
    "test:watch": "node --import tsx --test --watch __tests__/index.test.mjs",
    "test:coverage": "node --import tsx --test --experimental-test-coverage __tests__/index.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixu1980/pi-coding-agent-extensions.git",
    "directory": "packages/pi-mcp"
  },
  "homepage": "https://github.com/pixu1980/pi-coding-agent-extensions/tree/main/packages/pi-mcp#readme",
  "bugs": {
    "url": "https://github.com/pixu1980/pi-coding-agent-extensions/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "mcp",
    "model-context-protocol",
    "ai",
    "coding-agent",
    "extension",
    "claude",
    "llm"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "contentPolicy": "dual-use",
  "files": [
    "index.ts",
    "lib/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "DISCLOSURE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@napi-rs/keyring": "1.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cross-spawn": "7.0.6",
    "open": "11.0.0",
    "recheck": "4.5.0",
    "smol-toml": "1.7.1",
    "strip-json-comments": "5.0.3",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.83.0",
    "@earendil-works/pi-coding-agent": ">=0.83.0",
    "@earendil-works/pi-tui": ">=0.83.0",
    "typebox": "*",
    "zod": "4.4.3"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@modelcontextprotocol/conformance": "0.1.16",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.2",
    "@types/open": "6.2.1",
    "tsx": "4.23.1",
    "typebox": "1.3.9",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
