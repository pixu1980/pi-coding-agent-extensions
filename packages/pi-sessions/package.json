{
  "name": "@pixu1980/pi-sessions",
  "version": "0.1.5",
  "private": false,
  "description": "Session history overlay for pi.dev - browse, search, and restore past sessions with auto-naming based on chat content",
  "type": "module",
  "author": "Emiliano 'pixu1980' Pisu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixu1980/pi-coding-agent-extensions.git",
    "directory": "packages/pi-sessions"
  },
  "homepage": "https://github.com/pixu1980/pi-coding-agent-extensions/tree/main/packages/pi-sessions#readme",
  "bugs": {
    "url": "https://github.com/pixu1980/pi-coding-agent-extensions/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "session",
    "history"
  ],
  "files": [
    "index.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "release": "commit-and-tag-version --no-verify && npm publish",
    "release:dry": "commit-and-tag-version --dry-run",
    "test": "node --import tsx --test index.test.mjs",
    "test:coverage": "node --import tsx --test --experimental-test-coverage index.test.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.83.0",
    "@earendil-works/pi-tui": ">=0.83.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "^0.83.0",
    "tsx": "^4.23.1",
    "commit-and-tag-version": "^13.1.2"
  }
}
