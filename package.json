{
  "name": "pi-coding-agent-extensions",
  "version": "0.0.0",
  "private": true,
  "description": "Eight extensions for the pi coding agent, published independently to npm under @pixu1980",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixu1980/pi-coding-agent-extensions.git"
  },
  "homepage": "https://github.com/pixu1980/pi-coding-agent-extensions#readme",
  "bugs": {
    "url": "https://github.com/pixu1980/pi-coding-agent-extensions/issues"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "format": "prettier --write \"packages/*/lib/**/*.ts\" \"packages/*/index.ts\" \"packages/*/__tests__/**/*.mjs\" \"scripts/*.mjs\" \"test/*.mjs\"",
    "format:check": "prettier --check \"packages/*/lib/**/*.ts\" \"packages/*/index.ts\" \"packages/*/__tests__/**/*.mjs\" \"scripts/*.mjs\" \"test/*.mjs\"",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "test:all": "node scripts/test-all.mjs",
    "test:coverage": "node scripts/test-all.mjs --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "commit-and-tag-version": "13.2.1",
    "prettier": "3.9.6"
  }
}
