{
  "name": "@pixu1980/pi-lyceum",
  "version": "0.1.0",
  "private": false,
  "description": "Lyceum provider for pi.dev - run Lyceum's open models from pi through its OpenAI-compatible API, with your own API key stored only on your machine",
  "type": "module",
  "author": "Emiliano 'pixu1980' Pisu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixu1980/pi-coding-agent-extensions.git",
    "directory": "packages/pi-lyceum"
  },
  "homepage": "https://github.com/pixu1980/pi-coding-agent-extensions/tree/main/packages/pi-lyceum#readme",
  "bugs": {
    "url": "https://github.com/pixu1980/pi-coding-agent-extensions/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "lyceum",
    "provider",
    "openai-compatible",
    "api-key",
    "open-models"
  ],
  "contentPolicy": "dual-use",
  "files": [
    "index.ts",
    "lib/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "DISCLOSURE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --import tsx --test __tests__/index.test.mjs",
    "test:coverage": "node --import tsx --test --experimental-test-coverage __tests__/index.test.mjs",
    "typecheck": "tsc --noEmit",
    "release": "node ../../scripts/release.mjs",
    "release:dry": "node ../../scripts/release.mjs --dry-run"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@types/node": "26.6.0",
    "commit-and-tag-version": "13.2.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
