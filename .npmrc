# The registry and the publish access are explicit rather than inherited.
registry=https://registry.npmjs.org/
access=public

# The dependency cooldown is set in each pnpm-workspace.yaml, not here. pnpm 11
# reads minimumReleaseAge from the workspace file and defaults it to 1440
# minutes, so an entry in this file has no effect on it. The decision is ADR 012.
